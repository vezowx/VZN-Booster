<Window x:Class="VznBooster.Desktop.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VZN Booster — Ativação" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Digite sua chave de licença" FontSize="16" FontWeight="SemiBold"/>
        <TextBox x:Name="KeyBox" Margin="0,12,0,0" Padding="6"/>
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="IndianRed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Sair" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="EnterButton" Content="Ativar" Width="90" IsDefault="True" Click="Ativar_Click"/>
        </StackPanel>
    </StackPanel>
</Window>