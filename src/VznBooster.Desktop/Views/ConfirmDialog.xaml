<Window x:Class="VznBooster.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="580" SizeToContent="Height" MaxHeight="740" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="26,24,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" MaxHeight="380" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,9" Foreground="{StaticResource TextMutedBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <CheckBox x:Name="AckBox" Grid.Row="2" Margin="0,0,0,16" VerticalAlignment="Top"
                  Visibility="{Binding HasAcknowledge, Converter={StaticResource BoolToVis}}"
                  Checked="OnAckChanged" Unchecked="OnAckChanged">
            <TextBlock Text="{Binding AcknowledgeText}" TextWrapping="Wrap" MaxWidth="470"/>
        </CheckBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
            <Button x:Name="ConfirmButton" Content="Confirmar" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnConfirm"/>
        </StackPanel>
    </Grid>
</Window>
