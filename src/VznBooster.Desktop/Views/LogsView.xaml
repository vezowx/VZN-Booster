<UserControl x:Class="VznBooster.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ResultBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultKey}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultKey}" Value="Refused">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultKey}" Value="Cancelled">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="FilterChoice">
            <RadioButton Style="{StaticResource OptionRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" Margin="0,2,16,2"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">
            <TextBlock Text="Logs" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                       Text="Operações realmente executadas pelo aplicativo. IP, MAC e segredos são ocultados na gravação; caminhos com o seu nome de usuário seguem a política de privacidade."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Caminhos" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="{Binding PathsField.Icon}"
                                    ToolTip="{Binding PathsField.ToolTipText}" Command="{Binding PathsField.ToggleCommand}"/>
                        </StackPanel>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar por operação, categoria, resultado ou conteúdo"/>
                    </DockPanel>

                    <TextBlock Text="Resultado" Style="{StaticResource StatLabel}" Margin="0,14,0,2"/>
                    <ItemsControl ItemsSource="{Binding ResultOptions}" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource FilterChoice}"/>
                    <TextBlock Text="Categoria" Style="{StaticResource StatLabel}" Margin="0,8,0,2"/>
                    <ItemsControl ItemsSource="{Binding CategoryOptions}" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource FilterChoice}"/>
                    <TextBlock Text="Período" Style="{StaticResource StatLabel}" Margin="0,8,0,2"/>
                    <ItemsControl ItemsSource="{Binding PeriodOptions}" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource FilterChoice}"/>

                    <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
                    <CheckBox Content="Incluir dados pessoais na exportação (desmarcado por padrão)" IsChecked="{Binding IncludePersonal}" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Exportar texto…" Command="{Binding ExportTextCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Exportar JSON…" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Operation}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource ResultBadge}" Margin="10,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                                                    <Run Text="{Binding Time, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Detalhes" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Padding="12,5"/>
                                        </Grid>
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
