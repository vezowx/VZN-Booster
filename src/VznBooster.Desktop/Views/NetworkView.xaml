<UserControl x:Class="VznBooster.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="Network" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Diagnóstico real da conexão. Nenhuma configuração é alterada nesta tela." Style="{StaticResource Muted}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0"/>
                        <TextBlock Text="Adaptadores de rede" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Endereços IP" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="{Binding IpField.Icon}"
                                    ToolTip="{Binding IpField.ToolTipText}" Command="{Binding IpField.ToggleCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Gateway" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="{Binding GatewayField.Icon}"
                                    ToolTip="{Binding GatewayField.ToolTipText}" Command="{Binding GatewayField.ToggleCommand}"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding AdaptersInfo}" Style="{StaticResource Muted}" FontSize="12"/>
                    <ItemsControl ItemsSource="{Binding Adapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Teste de latência (ICMP)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Mede a latência até o destino informado. Não é o ping de um jogo."
                               Style="{StaticResource Muted}" Margin="0,4,0,14"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Destino (host ou IP)" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Width="260" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Amostras (1–100)" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Width="90" Text="{Binding SamplesText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Iniciar teste" Command="{Binding RunPingCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Usar gateway" Command="{Binding UseGatewayCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </WrapPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,16,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="Histórico desta sessão" Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,4"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel DataContext="{Binding Connectivity}">
                    <TextBlock Text="Diagnóstico e correções de rede" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="Mede o gateway (ICMP), o servidor DNS configurado (consulta real), o proxy do Windows e indícios de VPN. A medição não altera nada; as correções são oferecidas por achado e cada uma pede confirmação."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Diagnosticar minha rede" Command="{Binding DiagnoseCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>

                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SeverityKey}" Value="Problem">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SeverityKey}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                        <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Name}" Command="{Binding Command}" ToolTip="{Binding Description}"
                                                            Style="{StaticResource SecondaryButton}" Padding="12,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="VPN e proxy (por indícios)" FontWeight="SemiBold" Margin="0,16,0,0"
                               Visibility="{Binding HasVpnProxyLines, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding VpnProxyLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="12" Margin="0,16,0,0"
                            Visibility="{Binding HasFixResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Resultado da correção" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FixResult}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Correções avançadas (uso manual)" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6"
                               Text="Exigem administrador. Redefinir Winsock e TCP/IP pode derrubar a conexão e exige reiniciar o computador; use somente se as correções sugeridas não resolverem."/>
                    <TextBlock Text="Exige administrador para executar. Reinicie o VZN Booster como administrador." Foreground="{StaticResource WarnBrush}" FontSize="12"
                               Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding AllFixes}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding Command}" ToolTip="{Binding Warning}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Reiniciar como administrador" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel DataContext="{Binding Gaming}">
                    <TextBlock Text="Gaming Network" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="Estimativa indireta de proximidade antes de abrir o jogo. Nenhum destes jogos tem um destino de teste de ping oficial e verificado que o aplicativo possa usar, então o servidor da partida NÃO é medido: o aplicativo mede o handshake TCP até um endpoint regional público da AWS como referência de distância. O resultado nunca é apresentado como o ping da partida."/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar jogo" Margin="0,0,0,8"/>
                    <TextBlock Text="Jogo" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Games}" Margin="0,4,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource OptionRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding HasRegions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Região" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Regions}" Margin="0,4,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource OptionRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Estimar" Command="{Binding MeasureCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="Histórico desta sessão" Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,4"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel DataContext="{Binding Dns}">
                    <TextBlock Text="Comparar DNS" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="Mede o tempo de resolução de nomes de cada servidor, nesta conexão e neste momento (consultas DNS reais, IPv4). As consultas são enviadas aos servidores listados, incluindo os provedores públicos. O resultado inclui o cache do resolvedor e não representa o ping de um jogo."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Comparar DNS" Command="{Binding CompareCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Cancelar" Command="{Binding CancelCompareCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsComparing, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding CompareResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel DataContext="{Binding Dns}">
                    <TextBlock Text="Alterar DNS" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                               Text="Aplica um perfil de DNS IPv4 a UM adaptador, com backup do estado atual, verificação e restauração. O DNS afeta principalmente a resolução de nomes; não há garantia de redução de ping em partidas."/>
                    <TextBlock Text="Exige administrador. Reinicie o VZN Booster como administrador para aplicar ou restaurar." Foreground="{StaticResource WarnBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="Adaptador" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AdaptersInfo}" Style="{StaticResource Muted}" FontSize="12"/>
                    <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,4,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource OptionRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Perfil de DNS" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,4,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource OptionRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Ver plano" Command="{Binding PlanCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Aplicar DNS" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Restaurar DNS anterior" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Reiniciar como administrador" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <TextBlock Text="{Binding PlanText}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ainda não disponível nesta versão" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarnBrush}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Comparação antes/depois automática ao alterar o DNS (existe para as correções de conectividade), teste de velocidade (download/upload) e perfis de jogos personalizados."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
