<UserControl x:Class="VznBooster.Desktop.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RiskBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskKey}" Value="Moderate">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskKey}" Value="Advanced">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">
            <TextBlock Text="Cleaner" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                       Text="Fluxo: Analisar → revisar → selecionar categorias → confirmar → limpar. Nada é apagado sem sua confirmação, e a exclusão não é reversível."/>

            <Border Style="{StaticResource Card}" Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Executando sem administrador" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarnBrush}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="Categorias marcadas como &quot;pode exigir administrador&quot; (Windows\Temp, Prefetch, minidumps, relatórios do sistema, Otimização de Entrega) terão itens protegidos ignorados. O restante funciona normalmente."/>
                    <Button Content="Reiniciar como administrador" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Analisar" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Limpar selecionadas" Command="{Binding CleanCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource RiskBadge}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="28,4,0,0"/>
                                                        <TextBlock Text="{Binding Notes}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="28,4,0,0"
                                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="28,6,0,0"
                                                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" MinWidth="170">
                                                        <TextBlock Text="{Binding ResultText}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Resultado da limpeza" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ResultSummary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="O que o Cleaner nunca toca" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Logs de eventos e de segurança, pontos de restauração, backups, arquivo de paginação, arquivos pessoais, e dados de navegadores como senhas, cookies, sessões, histórico, favoritos e extensões. O cache de download do Windows Update não é incluído porque exigiria parar serviços."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
