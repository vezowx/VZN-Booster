<UserControl x:Class="VznBooster.Desktop.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StateBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="Disabled">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">
            <TextBlock Text="Inicialização" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="Programas que iniciam com o Windows. Desativar não desinstala nem apaga nada e pode ser desfeito. O aplicativo não classifica programas como seguros ou maliciosos pelo nome."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Caminhos" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Content="{Binding PathsField.Icon}"
                                    ToolTip="{Binding PathsField.ToolTipText}" Command="{Binding PathsField.ToggleCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource StateBadge}"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="{Binding SourceText, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding PublisherText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CommandText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding ToggleCommand}" Style="{StaticResource SecondaryButton}"
                                                Margin="16,0,0,0" VerticalAlignment="Top"
                                                Visibility="{Binding CanChange, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="O que esta tela cobre" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Entradas do registro (usuário atual e computador) e da pasta Inicializar do usuário. Entradas do computador são somente leitura (exigem administrador). Serviços e tarefas agendadas ainda não são listados. Itens que parecem de segurança exigem um reconhecimento adicional para serem desativados."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
