<UserControl x:Class="VznBooster.Desktop.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">
            <TextBlock Text="Restauração" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                       Text="Histórico de backups criados antes de cada ajuste. Você restaura um ajuste específico, sem desfazer os outros."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0"/>
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="{Binding Time, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="Risco: "/><Run Text="{Binding RiskText, Mode=OneWay}"/><Run Text="  •  Reinício: "/><Run Text="{Binding RestartText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Note}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Restaurar" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}"
                                                Margin="16,0,0,0" VerticalAlignment="Top"
                                                Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Ponto de restauração do Windows" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="Cria um ponto de restauração nativo do Windows. Ele não cobre todos os arquivos, aplicativos ou configurações; os ajustes do Tweaker usam backups próprios, mais precisos para cada valor alterado."/>
                    <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0"
                               Text="Requer administrador e Proteção do Sistema ativada. Sem administrador, a operação é recusada."
                               Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Criar ponto de restauração" Command="{Binding CreateRestorePointCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Reiniciar como administrador" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding ShowAdminNotice, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RestorePointResult}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding HasRestorePointResult, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
