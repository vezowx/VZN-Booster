<UserControl x:Class="VznBooster.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,24"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Em desenvolvimento" Style="{StaticResource SectionTitle}" Foreground="{StaticResource WarnBrush}"/>
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
