<UserControl x:Class="VznBooster.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VznBooster.Desktop.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24">

            <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Visão geral do computador com dados reais, coletados apenas enquanto esta tela está aberta."
                       Style="{StaticResource Muted}" Margin="0,4,0,18"/>

            <!-- Status geral -->
            <WrapPanel Margin="0,0,0,6">
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Computador" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ComputerName.Display}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,-4,0"
                                Content="{Binding ComputerName.Icon}" ToolTip="{Binding ComputerName.ToolTipText}"
                                Command="{Binding ComputerName.ToggleCommand}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Usuário" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding UserName.Display}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,-4,0"
                                Content="{Binding UserName.Icon}" ToolTip="{Binding UserName.ToolTipText}"
                                Command="{Binding UserName.ToggleCommand}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding OsText}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ligado há" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding UptimeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- CPU e RAM em destaque -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
                        <TextBlock Text="Uso total do processador" Style="{StaticResource Muted}" FontSize="12"/>
                        <c:Sparkline Height="96" Margin="0,14,0,0" Values="{Binding CpuValues}" Stroke="{StaticResource AccentLightBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Muted}" FontSize="12"/>
                        <c:Sparkline Height="96" Margin="0,14,0,0" Values="{Binding RamValues}" Stroke="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Armazenamento, rede e Cleaner -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="ARMAZENAMENTO" Style="{StaticResource StatLabel}"/>
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercent, StringFormat={}{0:0}% usado}" Style="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,6,0,4"/>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nenhuma unidade fixa legível." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding HasNoDrives, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Text="CONEXÃO" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                     Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Medir latência" Command="{Binding MeasureLatencyCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Abrir Network" Command="{Binding GoNetworkCommand}" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ESPAÇO RECUPERÁVEL" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding CleanerText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="Estimativa do Cleaner; o valor real só é conhecido após uma limpeza." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                        <Button Content="Abrir Cleaner" Command="{Binding GoCleanerCommand}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recomendações e histórico -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Recomendações para seu PC" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Baseadas apenas em medições deste computador. Nada é executado automaticamente."
                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6"/>
                        <TextBlock Text="Nenhuma recomendação no momento com base nos dados coletados."
                                   Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding HasNoRecommendations, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                                            <TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                                                <Run Text="Ação: " Foreground="{StaticResource TextBrush}"/><Run Text="{Binding Action, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                                <Run Text="Benefício esperado: " Foreground="{StaticResource TextBrush}"/><Run Text="{Binding Benefit, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                                <Run Text="Risco: " Foreground="{StaticResource TextBrush}"/><Run Text="{Binding Risk, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding AdminText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                            <Button Content="{Binding TargetLabel}" Command="{Binding GoCommand}" Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Últimas ações" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Nenhuma ação registrada ainda." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Visibility="{Binding HasNoActions, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding RecentActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                                <Run Text="{Binding Time, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Result, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sensores" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                       Text="Uso de GPU e temperaturas estão indisponíveis nesta versão: a leitura de sensores ainda não foi implementada, e nada é estimado no lugar."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
